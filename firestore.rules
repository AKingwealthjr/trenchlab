rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'alexkingsley@gmail.com' ||
        request.auth.token.email == 'precilexis@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Curated lesson resources
    match /lesson_resources/{resourceId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(resourceId);
    }

    // User profile document and personal progress subcollections
    match /users/{userId} {
      allow read: if isOwner(userId) && isValidId(userId);
      // Users may maintain their profile/progress summary but cannot self-grant
      // access by writing license or entitlement fields.
      allow create: if isOwner(userId) && isValidId(userId) &&
        request.resource.data.keys().hasOnly(['uid', 'displayName', 'email', 'photoURL', 'createdAt', 'level', 'levelName', 'xp', 'streak', 'lessonsCompleted', 'quizzesPassed', 'challengesCompleted']);
      allow update: if isOwner(userId) && isValidId(userId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'photoURL', 'level', 'levelName', 'xp', 'streak', 'lessonsCompleted', 'quizzesPassed', 'challengesCompleted']);

      // Lesson completion & assignment records
      match /progress/{lessonId} {
        allow read, write: if isOwner(userId) && isValidId(lessonId);
      }

      // Quiz attempts & scores
      match /quizzes/{quizId} {
        allow read, write: if isOwner(userId) && isValidId(quizId);
      }

      // Practical challenges
      match /challenges/{challengeId} {
        allow read, write: if isOwner(userId) && isValidId(challengeId);
      }

      // Trade journal entries
      match /journal/{tradeId} {
        allow read, write: if isOwner(userId) && isValidId(tradeId);
      }
    }
  }
}
